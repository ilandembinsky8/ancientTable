      value: "\u05D2\u05DD \u05E2\u05D5\u05E8 ]\u05D1\u05E2\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05E0\u05D1\u05D7\u05E8[ \u05E9\u05D9\u05DE\u05E9 \u05DC\u05D4\u05DB\u05E0\u05EA \u05D4\u05E7\u05DC\u05E3 \u05D0\u05DA \u05D4\u05DE\u05D2\u05D9\u05DC\u05D4 \u05E9\u05DC\u05E4\u05E0\u05D9\u05DB\u05DD \u05E2\u05E9\u05D5\u05D9\u05D4 \u05DE\u05D7\u05D5\u05DE\u05E8 \u05D0\u05D7\u05E8\n\n\u05D4\u05D3\u05D2\u05D9\u05DE\u05D4 \u05E9\u05D1\u05D7\u05E8\u05EA\u05DD \u05D0\u05D9\u05E0\u05D4 \u05EA\u05D5\u05D0\u05DE\u05EA \u05DC\u05E8\u05E6\u05E3 \u05D4\u05BEDNA \u05E9\u05DC \u05D4\u05DE\u05D2\u05D9\u05DC\u05D4. \u05D4\u05E9\u05D5\u05D5 \u05E9\u05D5\u05D1 \u05D1\u05D9\u05DF \u05D4\u05E8\u05E6\u05E4\u05D9\u05DD \u05D5\u05D1\u05D7\u05E8\u05D5 \u05D3\u05D2\u05D9\u05DE\u05D4 \u05D0\u05D7\u05E8\u05EA."
      objectReference: {fileID: 0}
