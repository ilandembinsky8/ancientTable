      value: TMP-Popup-RTL(fs16-Beige) Variant
      objectReference: {fileID: 0}
    - target: {fileID: 8021436292951145761, guid: 3f92bc8c3ff643d429473d8360dd9721, type: 3}
      propertyPath: m_text
      value: "\u05E4\u05E8\u05D5\u05EA \u05D1\u05DE\u05D3\u05D1\u05E8? \u05D1\u05D3\u05D9\u05E7\u05EA \u05D4-AND \u05E9\u05DC \u05D4\u05E7\u05DC\u05E3 \u05D2\u05D9\u05DC\u05EA\u05D4 \u05DC\u05E0\u05D5 \u05E9\"\u05DE\u05D2\u05D9\u05DC\u05EA \u05D9\u05E8\u05DE\u05D9\u05D4\u05D5\" \u05E9\u05E0\u05DE\u05E6\u05D0\u05D4 \u05D1\u05E7\u05D5\u05DE\u05E8\u05D0\u05DF \u05E0\u05DB\u05EA\u05D1\u05D4 \u05E2\u05DC \u05E2\u05D5\u05E8 \u05E9\u05DC \u05E4\u05E8\u05D4 -\_ \u05D1\u05D4\u05DE\u05D4 \u05DB\u05E9\u05E8\u05D4 \u05E9\u05D0\u05E3 \u05E9\u05D9\u05DE\u05E9\u05D4 \u05DC\u05E7\u05E8\u05D1\u05E0\u05D5\u05EA \u05D1\u05DE\u05E7\u05D3\u05E9, \u05D0\u05D1\u05DC \u05DC\u05D0 \u05DE\u05EA\u05D0\u05D9\u05DE\u05D4 \u05DC\u05D7\u05D9\u05D9\u05DD \u05D1\u05DE\u05D3\u05D1\u05E8 \u05D9\u05D4\u05D5\u05D3\u05D4 \u05D4\u05D7\u05DD \u05D5\u05D4\u05E6\u05D7\u05D9\u05D7. \u05D4\u05EA\u05D2\u05DC\u05D9\u05EA \u05E1\u05D9\u05D9\u05E2\u05D4 \u05DC\u05E0\u05D5 \u05DC\u05D4\u05D1\u05D9\u05DF \u05E9\u05D4\u05DE\u05D2\u05D9\u05DC\u05D4 \u05E0\u05DB\u05EA\u05D1\u05D4 \u05DE\u05D7\u05D5\u05E5 \u05DC\u05E7\u05D5\u05DE\u05E8\u05D0\u05DF \u05D5\u05D4\u05D5\u05D1\u05D0\u05D4 \u05D0\u05DC \u05D4\u05D9\u05D9\u05E9\u05D5\u05D1 \u05DE\u05E8\u05D7\u05D5\u05E7, \u05D0\u05D5\u05DC\u05D9 \u05DB\u05DE\u05E7\u05D5\u05DD \u05DE\u05D9\u05E1\u05EA\u05D5\u05E8 \u05D5\u05D4\u05D2\u05E0\u05D4 \u05DC\u05DB\u05EA\u05D1\u05D9\u05DD \u05D7\u05E9\u05D5\u05D1\u05D9\u05DD \u05DE\u05E8\u05D7\u05D1\u05D9 \u05D4\u05D0\u05E8\u05E5."
      objectReference: {fileID: 0}
