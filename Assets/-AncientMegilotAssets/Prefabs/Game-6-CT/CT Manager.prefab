    - target: {fileID: 8930958291797940777, guid: f54686258e9c47e4eba87e5d6341d0eb, type: 3}
      propertyPath: m_text
      value: "13   [\u05D4\u05B7\u05DB\u05B9\u05BC]\u05D4\u05B5\u05DF \u05D0\u05B5\u05E9\u05C1 \u05E2\u05B7\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B7 [\u05D5\u05B0]\u05E2\u05B8\u05E8\u05B0\u05DB\u05D5\u05BC \u05E2\u05B5\u05E6\u05B4\u05D9\u05DD \u05E2\u05B7\u05DC [\u05D4\u05B8\u05D0\u05B5\u05E9\u05C1]\n14   [\u05D5\u05B0\u05E2\u05B8\u05E8\u05B0\u05DB]\u05D5\u05BC \u05D1\u05B0\u05BC\u05E0\u05B5\u05D9 \u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF \u05D4\u05B7\u05DB\u05B9\u05BC[\u05D4\u05B2\u05E0\u05B4\u05D9\u05DD \u05D0\u05B6\u05EA \u05D4\u05B7\u05E0\u05B0\u05BC\u05EA\u05B8\u05D7\u05B4\u05D9\u05DD]\u2078 \u05D0\u05B6\u05EA\n15   [\u05D4\u05B8\u05E8\u05B9\u05D0\u05E9\u05C1] \u05D5\u05B0\u05D0\u05B6\u05EA \u05D4\u05B7\u05E4\u05B8\u05BC\u05D3\u05B6\u05E8 \u05E2\u05B7\u05DC [\u05D4\u05B8\u05E2\u05B5\u05E6\u05B4\u05D9\u05DD \u05D0\u05B2\u05E9\u05B6\u05C1\u05E8 \u05E2\u05B7\u05DC] \u05D4\u05B8\u05D0\u05B5\u05E9\u05C1\n16   [\u05D0\u05B2\u05E9\u05B6\u05C1\u05E8] \u05E2\u05B7\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B7 [\u05D5\u05BC]\u05E7\u05B4\u05E8\u05B0\u05D1\u05BC\u05D5\u05B9\u2079 \u05D9\u05B4\u05E8\u05B0\u05D7\u05B7\u05E5 \u05D1\u05B7\u05BC\u05DE\u05B7\u05BC\u05D9\u05B4[\u05DD]\n17   [\u05D5\u05B0\u05D4\u05B4\u05E7\u05B0\u05D8\u05B4\u05D9\u05E8 \u05D4\u05B7]\u05DB\u05B9\u05BC\u05D4\u05B5\u05DF \u05D0\u05B6\u05EA [\u05D4\u05B7\u05DB\u05B9\u05BC\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B8\u05D4 \u05E2\u05B9\u05DC\u05B8\u05D4 \u05D0\u05B4\u05E9\u05B5\u05BC\u05C1\u05D4]\n18   remains of letters\n\n\u05E2\u05DE\u05D5\u05D3\u05D4 II | \u05D5\u05D9\u05E7\u05E8\u05D0 \u05D1\u05F3: 1\u201311\n01   remains of letters\n02   [\u05D5\u05E0\u05EA] \u05E2\u05B8\u05DC\u05B6\u05D9\u05D4\u05B8 [\u05DC\u05B0\u05D1\u05B9\u05E0\u05B8\u05D4]\xB2 \u05D5\u05B6\u05D4\u05B1\u05D1\u05B4\u05D9\u05D0\u05B8\u05D4\u05BC \u05D0\u05B6\u05DC \u05D1\u05B0\u05BC\u05E0\u05B5\u05D9 \u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF \u05D4\u05B7\u05DB\u05B9\u05BC\u05D4\u05B2\u05E0\u05B4\u05D9\u05DD\n03   \u05D5\u05B0\u05E7\u05B8\u05DE\u05B7\u05E5 \u05DE\u05B4\u05E9\u05B8\u05BC\u05C1\u05DD [\u05DE\u05B0\u05DC\u05B9\u05D0 \u05E7\u05BB\u05DE\u05B0\u05E6\u05D5\u05B9 \u05DE\u05B4\u05E1\u05B8\u05BC\u05DC\u05B0\u05EA\u05B8\u05BC\u05D4\u05BC \u05D5\u05BC\u05DE\u05B4\u05E9\u05B7\u05BC\u05C1\u05DE\u05B0\u05E0\u05B8\u05D4\u05BC \u05E2\u05B7\u05DC] \u05DB\u05B8\u05BC\u05DC\n04   \u05DC\u05B0\u05D1\u05B9\u05E0\u05B8\u05EA\u05B8\u05D4\u05BC \u05D5\u05B0\u05D4\u05B4\u05E7\u05B0\u05D8\u05B4[\u05D9]\u05E8 \u05D4\u05B7\u05DB\u05B9\u05BC\u05D4\u05B5\u05DF \u05D0\u05B6\u05EA [\u05D0\u05B7\u05D6\u05B0\u05DB\u05B8\u05BC\u05E8\u05B8\u05EA\u05B8\u05D4\u05BC] \u05D4\u05B7\u05DE\u05B4\u05BC[\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B8\u05D4]\n05   \u05D0\u05B4\u05E9\u05B5\u05BC\u05C1\u05D4 \u05E8\u05B5\u05D9\u05D7\u05B7 \u05E0\u05B4\u05D9\u05D7\u05B9\u05D7\u05B7 \u05DC\u05B7\u05D9\u05D4\u05D5\u05B8\u05D4\xB3 \u05D5\u05B0\u05D4\u05B7\u05E0\u05BC\u05D5\u05B9[\u05EA\u05B6\u05E8\u05B6\u05EA \u05DE\u05B4\u05DF \u05D4\u05B7\u05DE\u05B4\u05BC\u05E0\u05B0\u05D7\u05B8\u05D4]\n06   \u05DC\u05B0\u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF \u05D5\u05BC\u05DC\u05B0\u05D1\u05B8\u05E0\u05B8\u05D9\u05D5 \u05E7\u05B9\u05D3\u05B6\u05E9\u05C1 \u05E7\u05B8\u05D3\u05B8\u05E9\u05B4\u05C1\u05D9\u05DD \u05DE\u05B5\u05D0\u05B4\u05E9\u05B5\u05BC\u05C1[\u05D9 \u05D9\u05B0\u05D4\u05D5\u05B8]\u05D4 vac\u2074 \u05D5\u05B0\u05DB\u05B4\u05D9\n07   \u05EA\u05B7\u05BC\u05E7\u05B0\u05E8\u05B4\u05D1 \u05E7\u05B8\u05E8\u05B0\u05D1\u05B7\u05BC[\u05DF \u05DE\u05B4\u05E0\u05B0\u05D7\u05B8\u05D4] \u05DE\u05B7\u05D0\u05B2\u05E4\u05B5\u05D4 \u05EA\u05B7\u05E0\u05BC\u05D5\u05BC\u05E8 \u05E1\u05B9\u05DC\u05B6\u05EA \u05D7\u05B7\u05DC\u05BC\u05D5\u05B9\u05EA \u05DE\u05B7\u05E6\u05B9\u05BC\u05EA\n08   \u05D1\u05B0\u05BC\u05DC\u05D5\u05BC\u05DC\u05B9\u05EA \u05D1\u05B7\u05BC\u05E9\u05B6\u05BC\u05C1[\u05DE\u05B6\u05DF \u05D5\u05BC\u05E8\u05B0\u05E7\u05B4\u05D9\u05E7\u05B5\u05D9] \u05DE\u05B7\u05E6\u05BC\u05D5\u05B9\u05EA \u05DE\u05B0\u05E9\u05BB\u05C1\u05D7\u05B4\u05D9\u05DD \u05D1\u05B7\u05BC\u05E9\u05B8\u05BC\u05C1\u05DE\u05B6\u05DF vac\u2075 \u05D5\u05B0\u05D0\u05B4\u05DD\n09   \u05DE\u05B4\u05E0\u05B0\u05D7\u05B8\u05D4 \u05E2\u05B7\u05DC [\u05D4\u05B7\u05DE\u05B7\u05BC\u05D7\u05B2\u05D1\u05B7\u05EA] \u05E7\u05B8\u05E8\u05B0\u05D1\u05B8\u05BC\u05E0\u05B0\u05DA\u05B8 \u05E1\u05B9\u05DC\u05B6\u05EA \u05D1\u05B0\u05BC\u05DC\u05D5\u05BC\u05DC\u05B8\u05D4 \u05D1\u05B7\u05BC\u05E9\u05B6\u05BC\u05C1\u05DE\u05B6\u05DF\n10   \u05DE\u05B7\u05E6\u05B8\u05BC\u05D4 \u05EA\u05B4\u05D4\u05B0[\u05D9\u05B6\u05D4 \u05E4\u05B8\u05BC\u05EA\u05D5\u05B9\u05EA] \u05D0\u05B9\u05EA\u05B8\u05D4\u05BC \u05E4\u05B4\u05BC\u05EA\u05B4\u05BC\u05D9\u05DD \u05D5\u05B0\u05D9\u05B8\u05E6\u05B7\u05E7\u05B0\u05EA\u05B8\u05BC \u05E2\u05B8\u05DC\u05B6\u05D9\u05D4\u05B8\n11   \u05E9\u05B6\u05C1\u05DE\u05B6\u05DF \u05DE\u05B4\u05E0\u05B0[\u05D7\u05B8\u05D4 \u05D4\u05B4\u05D5\u05D0]\u2077 \u05D0\u05B4\u05DD \u05DE\u05B4\u05E0\u05B0\u05D7\u05B7\u05EA [\u05DE\u05B7\u05E8\u05B0]\u05D7\u05B6\u05E9\u05B6\u05C1\u05EA \u05E7\u05B8\u05E8\u05B0\u05D1\u05B8\u05BC\u05E0\u05B0\u05DA\u05B8\n12   \u05E1\u05B9\u05DC\u05B6\u05EA \u05D1\u05B7\u05BC[\u05E9\u05B6\u05BC\u05C1\u05DE\u05B6\u05DF \u05EA\u05B5\u05BC\u05E2\u05B8\u05E9\u05B6\u05C2\u05D4]\u2078 \u05D5\u05B0\u05D4\u05B5\u05D1\u05B5\u05D0\u05EA\u05B8 \u05D0\u05B6\u05EA \u05D4\u05B7\u05DE\u05B4\u05BC\u05E0\u05B0[\u05D7\u05B8\u05D4 \u05D0\u05B2\u05E9\u05B6\u05C1\u05E8]\n13   \u05D9\u05B5\u05E2\u05B8\u05E9\u05B6\u05C2\u05D4 [\u05DE\u05B5\u05D0\u05B5\u05DC\u05B6\u05BC\u05D4 \u05DC\u05B7\u05D9\u05D4\u05D5\u05B8\u05D4 \u05D5\u05B0\u05D4\u05B4]\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1\u05B8\u05D4\u05BC \u05D0\u05B6\u05DC \u05D4\u05B7\u05DB\u05B9\u05BC\u05D4\u05B5\u05DF\n14   \u05D5\u05B0\u05D4\u05B4\u05D2\u05B4\u05BC\u05D9\u05E9\u05B8\u05C1\u05D4\u05BC [\u05D0\u05B6\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B7]\u2079 \u05D5\u05B0\u05D4\u05B5[\u05E8\u05B4\u05D9\u05DD \u05D4\u05B7\u05DB\u05B9\u05BC\u05D4\u05B5\u05DF \u05DE\u05B4\u05DF \u05D4\u05B7\u05DE\u05B4\u05BC\u05E0\u05B0\u05D7\u05B8\u05D4]\n15   \u05D0\u05B6\u05EA \u05D0\u05B7\u05D6\u05B0[\u05DB\u05B8\u05BC\u05E8\u05B8\u05EA\u05B8\u05D4\u05BC \u05D5\u05B0\u05D4\u05B4\u05E7\u05B0\u05D8\u05B4\u05D9\u05E8 \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0]\u05D1\u05B5\u05BC\u05D7\u05B8\u05D4 \u05D0\u05B4\u05E9\u05B5\u05BC\u05C1\u05D4 \u05E8\u05B5\u05D9\u05D7\u05B7\n16   \u05E0\u05B4\u05D9\u05D7\u05B9\u05D7\u05B7 \u05DC\u05B7\u05D9\u05D4\u05D5\u05B8[\u05D4]\xB9\u2070 \u05D5\u05B0\u05D4\u05B7\u05E0\u05BC\u05D5\u05B9\u05EA\u05B6\u05E8\u05B6\u05EA \u05DE\u05B4\u05DF [\u05D4\u05B7\u05DE\u05B4\u05BC\u05E0\u05B0\u05D7\u05B8\u05D4 \u05DC\u05B0\u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF]\n17   \u05D5\u05BC\u05DC\u05B0\u05D1\u05B8\u05E0\u05B8\u05D9\u05D5 [\u05E7\u05B9]\u05D3\u05B6\u05E9\u05C1 \u05E7\u05B8\u05D3\u05B8\u05E9\u05B4\u05C1\u05D9\u05DD \u05DE\u05B5\u05D0\u05B4\u05E9\u05B5\u05BC\u05C1[\u05D9 \u05D9\u05B0\u05D4\u05D5\u05B8\u05D4]\xB9\xB9 \u05DB\u05B8\u05BC\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05E0\u05B0\u05D7\u05B8\u05D4\n18   \u05D0\u05B2\u05E9\u05B6\u05C1\u05E8 [\u05EA\u05B7\u05BC\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1\u05D5\u05BC \u05DC\u05B7\u05D9\u05D4\u05D5\u05B8\u05D4 \u05DC\u05B9\u05D0 \u05EA\u05B5\u05E2\u05B8]\u05E9\u05B6\u05C2\u05D4 \u05D7\u05B8\u05DE\u05B5\u05E5 \u05DB\u05B4\u05BC\u05D9 \u05DB\u05B8\u05BC[\u05DC \u05E9\u05B0\u05C2\u05D0\u05B9\u05E8]\n\n"
