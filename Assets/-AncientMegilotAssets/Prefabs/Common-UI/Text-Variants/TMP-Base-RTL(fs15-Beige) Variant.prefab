    - target: {fileID: 2412941344454695796, guid: 7b157faca8c6a9944b0a0cf1fe1fbb21, type: 3}
      propertyPath: m_text
      value: "\u05E2\u05DE\u05D5\u05D3\u05D4 I | \u05D5\u05D9\u05E7\u05E8\u05D0 \u05D0\u05F3: 1\u20139\n01   \u05D5\u05B7\u05D9\u05B4\u05BC\u05E7\u05B0\u05E8\u05B8[\u05D0 \u05D0\u05B6\u05DC \u05DE\u05B9\u05E9\u05B6\u05C1\u05D4 \u05D5\u05B7\u05D9\u05B0]\u05D3\u05B7\u05D1\u05B5\u05BC\u05E8 \u05D9\u05B0\u05D4\u05D5\u05B8\u05D4 \u05D0\u05B5\u05DC\u05B8\u05D9\u05D5 \u05DE\u05B5\u05D0\u05B9[\u05D4\u05B6\u05DC]\n02   \u05DE\u05D5\u05B9\u05E2\u05B5[\u05D3 \u05DC\u05B5\u05D0\u05DE\u05B9\u05E8 \u05D3\u05B7\u05BC]\u05D1\u05B5\u05BC\u05E8 \u05D0\u05B6\u05DC \u05D1\u05B0\u05BC\u05E0\u05B5\u05D9 \u05D9\u05B4\u05E9\u05B0\u05C2\u05E8\u05B8\u05D0\u05B5\u05DC \u05D5\u05B0\u05D0\u05B8\u05DE\u05B7[\u05E8\u05B0\u05EA\u05B8\u05BC]\n03   \u05D0\u05B2\u05DC\u05B5[\u05D4\u05B6\u05DD \u05D0\u05B8\u05D3\u05B8\u05DD] \u05DB\u05B4\u05BC\u05D9 \u05D9\u05B7\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1 \u05DE\u05B4\u05DB\u05B6\u05BC\u05DD \u05E7\u05B8\u05E8\u05B0\u05D1\u05B8\u05BC\u05DF \u05DC\u05B7\u05D9\u05D4\u05D5\u05B8\u05D4 [\u05DE\u05B4\u05DF]\n04   \u05D4\u05B7\u05D1\u05B0\u05BC\u05D4\u05B5\u05DE\u05B8\u05D4 \u05DE\u05B4\u05DF \u05D4\u05B7\u05D1\u05B8\u05BC\u05E7\u05B8\u05E8 [\u05D5\u05BC]\u05DE\u05B4\u05DF \u05D4\u05B7\u05E6\u05B9\u05BC\u05D0\u05DF \u05EA\u05B7\u05BC\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1\u05D5\u05BC \u05D0\u05B6\u05EA\n05   \u05E7\u05B8\u05E8\u05B0\u05D1\u05B7\u05BC\u05E0\u05B0\u05DB\u05B6\u05DD\xB3 \u05D0\u05B4\u05DD \u05E2\u05B9\u05DC\u05B8\u05D4 \u05E7\u05B8\u05E8\u05B0\u05D1\u05B8\u05BC\u05E0\u05D5\u05B9 \u05DE\u05B4\u05DF \u05D4\u05B7\u05D1\u05B8\u05BC\u05E7\u05B8\u05E8 \u05D6\u05B8\u05DB\u05B8\u05E8\n06   \u05EA\u05B8\u05BC\u05DE\u05B4\u05D9\u05DD \u05D9\u05B7\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1\u05B6\u05E0\u05BC\u05D5\u05BC \u05D0\u05B6\u05DC \u05E4\u05B6\u05BC\u05EA\u05B7\u05D7 \u05D0\u05B9\u05D4\u05B6\u05DC \u05DE\u05D5\u05B9\u05E2\u05B5\u05D3 \u05D9\u05B7\u05E7\u05B0\u05E8\u05B4\u05D9\u05D1\n07   \u05D0\u05B9\u05EA\u05D5\u05B9 \u05DC\u05B4\u05E8\u05B0\u05E6\u05B9\u05E0\u05D5\u05B9 \u05DC\u05B4\u05E4\u05B0\u05E0\u05B5\u05D9 \u05D9\u05B0\u05D4\u05D5\u05B8\u05D4 \u05D5\u05B0\u05E1\u05B8\u05DE\u05B7\u05DA\u05B0\u2074 \u05D9\u05B8\u05D3\u05D5\u05B9 \u05E2\u05B7\u05DC \u05E8\u05B9\u05D0\u05E9\u05C1\n08   \u05D4\u05B8\u05E2\u05B9[\u05DC\u05B8]\u05D4 \u05D5\u05B0\u05E0\u05B4\u05E8\u05B0\u05E6\u05B8\u05D4 \u05DC\u05D5\u05B9 \u05DC\u05B0\u05DB\u05B7\u05E4\u05B5\u05BC\u05E8 [\u05E2\u05B8\u05DC\u05B8\u05D9\u05D5\u2075 \u05D5\u05B0\u05E9\u05B8\u05C1\u05D7\u05B7]\u05D8 \u05D0\u05B6\u05EA \u05D1\u05B6\u05BC\u05DF\n09   \u05D4\u05B7\u05D1\u05B8\u05BC\u05E7\u05B8\u05E8 \u05DC\u05B4\u05E4\u05B0\u05E0\u05B5\u05D9 \u05D9\u05B0\u05D4\u05D5\u05B8\u05D4 \u05D5\u05B0\u05D4\u05B4\u05E7\u05B0\u05E8\u05B4[\u05D9\u05D1\u05D5\u05BC \u05D1\u05B0\u05BC\u05E0\u05B5\u05D9] \u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF\n10   [\u05D4\u05B7\u05DB\u05B9\u05BC]\u05D4\u05B2\u05E0\u05B4\u05D9\u05DD \u05D0\u05B6\u05EA \u05D4\u05B7\u05D3\u05B8\u05BC\u05DD [\u05D5\u05B0]\u05D6\u05B8\u05E8\u05B0\u05E7[\u05D5\u05BC \u05D0\u05B6\u05EA \u05D4\u05B7\u05D3\u05B8\u05BC\u05DD] \u05E2\u05B7\u05DC \u05D4\u05B7\u05DE\u05B4\u05BC\u05D6\u05B0\u05D1\u05B5\u05BC\u05D7\u05B7\n11   [\u05E1\u05B8\u05D1\u05B4\u05D9]\u05D1 \u05D0\u05B2\u05E9\u05B6\u05C1\u05E8 \u05E4\u05B6\u05BC\u05EA\u05B7\u05D7 \u05D0\u05B9\u05D4\u05B6\u05DC \u05DE[\u05D5\u05B9\u05E2\u05B5\u05D3 \u05D5\u05B0\u05D4\u05B4\u05E4\u05B0\u05E9\u05B4\u05C1\u05D9\u05D8]\u2076 \u05D0\u05B6\u05EA\n12   [\u05D4\u05B8\u05E2\u05B9]\u05DC\u05B8\u05D4 \u05D5\u05B0\u05E0\u05B4\u05EA\u05B7\u05BC[\u05D7] \u05D0\u05B9\u05EA\u05B8\u05D4\u05BC \u05DC\u05B4\u05E0\u05B0\u05EA\u05B8\u05D7\u05B6[\u05D9\u05D4\u05B8]\u2077 \u05D5\u05B0\u05E0\u05B8\u05EA\u05B0\u05E0\u05D5\u05BC \u05D1\u05B0\u05BC\u05E0\u05B5\u05D9 \u05D0\u05B7\u05D4\u05B2\u05E8\u05B9\u05DF\n"
