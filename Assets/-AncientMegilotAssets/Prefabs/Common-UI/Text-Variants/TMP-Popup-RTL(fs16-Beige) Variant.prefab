    m_Modifications:
    - target: {fileID: 2412941344454695796, guid: 7b157faca8c6a9944b0a0cf1fe1fbb21, type: 3}
      propertyPath: m_text
      value: "\u05E9\u05E0\u05D9 \u05DB\u05EA\u05D1\u05D9 \u05D9\u05D3 \u05D1\u05DC\u05D1\u05D3 \u05E9\u05DC \u05D8\u05E7\u05E1\u05D8 \u05D6\u05D4 \u05E9\u05E8\u05D3\u05D5. \u05D4\u05DD \u05DE\u05EA\u05D0\u05E8\u05D9\u05DD \u05D0\u05EA \u05DE\u05DC\u05D7\u05DE\u05EA \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC \u05D9\u05E9\u05E8\u05D0\u05DC \u05E0\u05D2\u05D3 \u05D0\u05D5\u05D9\u05D1\u05D9\u05D4 - \u05D4\u05DB\u05D9\u05EA\u05D9\u05DD, \u05DB\u05D9\u05E0\u05D5\u05D9 \u05D0\u05E4\u05E9\u05E8\u05D9 \u05DC\u05E8\u05D5\u05DE\u05D0\u05D9\u05DD. \u05D1\u05DE\u05D4\u05DC\u05DA \u05D4\u05E7\u05E8\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF, \u05DE\u05DC\u05DA \u05D4\u05DB\u05D9\u05EA\u05D9\u05DD \u05E0\u05DC\u05DB\u05D3, \u05E2\u05D5\u05DE\u05D3 \u05DC\u05D3\u05D9\u05DF \u05D5\u05DE\u05D5\u05E6\u05D0 \u05DC\u05D4\u05D5\u05E8\u05D2 \u05D1\u05D9\u05D3\u05D9 \u05E0\u05E9\u05D9\u05D0 \u05D4\u05E2\u05D3\u05D4. \u05D4\u05E0\u05D5\u05E9\u05D0 \u05D4\u05DE\u05E8\u05DB\u05D6\u05D9 \u05E9\u05DC \u05D4\u05D8\u05E7\u05E1\u05D8 \u05D4\u05D5\u05D0 \u05D1\u05E8\u05DB\u05D4 \u05E9\u05DE\u05D5\u05E2\u05E0\u05E7\u05EA \u05D1\u05D9\u05D3\u05D9 \u05D4\u05DB\u05D4\u05DF \u05D4\u05D2\u05D3\u05D5\u05DC \u05D1\u05D7\u05D2\u05D9\u05D2\u05D4 \u05D6\u05D5.\n\n\u05D4\u05D3\u05DE\u05D9\u05D5\u05DF \u05D4\u05E8\u05D1 \u05D1\u05D9\u05DF \u05D9\u05E6\u05D9\u05E8\u05D4 \u05D6\u05D5 \u05DC\u05E1\u05E4\u05E8 \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4 \u05DE\u05E8\u05DE\u05D6 \u05DB\u05D9 \u05E9\u05E0\u05D9\u05D4\u05DD \u05E2\u05E9\u05D5\u05D9\u05D9\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05D4\u05E7\u05D8\u05E2 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC \u05DE\u05D2\u05D9\u05DC\u05EA \u05D4\u05DE\u05DC\u05D7\u05DE\u05D4."
      objectReference: {fileID: 0}
