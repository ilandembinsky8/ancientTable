--- !u!1001 &6010695138059422742
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1240203774083471775}
    m_Modifications:
    - target: {fileID: 3171615864316941695, guid: 3f92bc8c3ff643d429473d8360dd9721, type: 3}
      propertyPath: m_Name
      value: TMP-Popup-RTL(fs16-Beige) Variant-Translation
      objectReference: {fileID: 0}
    - target: {fileID: 8021436292951145761, guid: 3f92bc8c3ff643d429473d8360dd9721, type: 3}
      propertyPath: m_text
      value: "\u05D9\u05B0\u05D1\u05B8\u05E8\u05B6\u05DB\u05B0\u05DA\u05B8 \u05D0\u05B5\u05DC \u05E2\u05B6\u05DC\u05B0\u05D9\u05D5\u05B9\u05DF, \u05D5\u05B0\u05D9\u05B8\u05D0\u05B5\u05E8 \u05E4\u05B8\u05BC\u05E0\u05B8\u05D9\u05D5 \u05D0\u05B5\u05DC\u05B6\u05D9\u05DA\u05B8; \u05D5\u05B0\u05D9\u05B4\u05E4\u05B0\u05EA\u05B7\u05BC\u05D7 \u05DC\u05B0\u05DA\u05B8 \u05D0\u05B6\u05EA \u05D0\u05D5\u05B9\u05E6\u05B8\u05E8\u05D5\u05B9 \u05D4\u05B7\u05D8\u05BC\u05D5\u05B9\u05D1, \u05D0\u05B6\u05EA \u05D4\u05B7\u05E9\u05B8\u05BC\u05C1\u05DE\u05B7\u05D9\u05B4\u05DD, \u05DC\u05B8\u05EA\u05B5\u05EA \u05DE\u05B0\u05D8\u05B7\u05E8 \u05D0\u05B7\u05E8\u05B0\u05E6\u05B0\u05DA\u05B8 \u05D1\u05B0\u05BC\u05E2\u05B4\u05EA\u05BC\u05D5\u05B9, \u05D8\u05B7\u05DC \u05D5\u05BC\u05DE\u05B8\u05D8\u05B8\u05E8, \u05D9\u05D5\u05B9\u05E8\u05B6\u05D4 \u05D5\u05BC\u05DE\u05B7\u05DC\u05B0\u05E7\u05D5\u05B9\u05E9\u05C1 \u05D1\u05B0\u05BC\u05E2\u05B4\u05EA\u05B8\u05BC\u05DD; \u05D5\u05B0\u05D9\u05B4\u05EA\u05B5\u05BC\u05DF \u05DC\u05B0\u05DA\u05B8 \u05E4\u05B0\u05BC\u05E8\u05B4\u05D9 \u05D8\u05D5\u05B9\u05D1, \u05D3\u05B8\u05BC\u05D2\u05B8\u05DF \u05D5\u05B0\u05EA\u05B4\u05D9\u05E8\u05D5\u05B9\u05E9\u05C1 \u05D5\u05B0\u05D9\u05B4\u05E6\u05B0\u05D4\u05B8\u05E8 \u05DC\u05B8\u05E8\u05B9\u05D1."
      objectReference: {fileID: 0}
