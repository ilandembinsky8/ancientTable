# .claudeignore — MobileMoneyGame (Unity)
# Keeps Claude out of generated/cache folders so it only reads real project files.

# Unity generated caches (huge, fully regenerated by the editor)
Library/
Temp/
Obj/
obj/
Logs/
UserSettings/
MemoryCaptures/
Recordings/

# Build outputs
Build/
Builds/
build/
ServerData/

# IDE / OS noise
.vs/
.idea/
.vscode/
.utmp/
.consulo/
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.DS_Store
Thumbs.db

# Generated C# project files (Unity recreates these; the code lives in Assets/)
*.csproj
*.sln
crashlytics-build.properties

# Unity meta files — mostly GUID noise when reading code.
# Remove this line if you ever want me to audit asset references/GUIDs.
*.meta

# Asset store cache / addressables build artifacts
[Aa]ssets/AssetStoreTools*
[Aa]ssets/StreamingAssets/aa/
